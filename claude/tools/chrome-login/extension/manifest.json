{
  "manifest_version": 3,
  "name": "CryptoFort Login",
  "version": "1.0.0",
  "description": "Fills a site's sign-in from the CryptoFort vault once Touch ID approves it.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "storage", "alarms", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "CryptoFort Login", "default_popup": "popup.html" }
}
