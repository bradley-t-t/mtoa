{
  "manifest_version": 3,
  "name": "Chrome Login",
  "version": "1.0.0",
  "description": "Fills a sign-in from the CryptoFort vault when chrome-login.py asks and the owner has approved it.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "scripting", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" }
}
